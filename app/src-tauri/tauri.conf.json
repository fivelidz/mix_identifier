{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixID",
  "version": "0.1.0",
  "identifier": "com.fivelidz.mixid",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MixID",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "AudioVideo",
    "shortDescription": "MixID — identify tracks in DJ mixes",
    "longDescription": "Fingerprint your music library, then identify which tracks play in any DJ mix, with timestamps and confidence."
  }
}
